# =============================================================================
# GridPulse — .gitignore
# =============================================================================
# IMPORTANT: Never commit secrets, credentials, or large binary files.

# -- Secrets & Environment -----------------------------------------------------
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/

# -- Python --------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/

# -- Node.js -------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
.next/
.nuxt/
.output/
.cache/

# -- Build output --------------------------------------------------------------
dist/
build/

# -- macOS ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# -- Windows -------------------------------------------------------------------
Thumbs.db
desktop.ini

# -- IDEs & Editors ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# -- Large Media Files (use demo-video-link.txt instead) -----------------------
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv

# -- Docker volumes / local data -----------------------------------------------
logs/
*.log

# -- Do NOT commit the organizer reference copy --------------------------------
organizer-template/
