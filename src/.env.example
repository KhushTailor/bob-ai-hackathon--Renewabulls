# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.
#
# All five GridPulse features work with both WATSONX_*_ENABLED flags set to false.
# Set them to true only if you have active IBM Cloud watsonx.ai credentials.

# ── IBM watsonx.ai ─────────────────────────────────────────────────────────────
# Required only when WATSONX_GRANITE_TTM_ENABLED=true or WATSONX_BRIEF_ENABLED=true
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Feature toggles ────────────────────────────────────────────────────────────
# Granite TTM: IBM Granite time-series model for demand forecasting (Feature 1)
# Set to true to use ibm/granite-ttm-512-96-r2 via watsonx.ai forecast API
# Set to false (default) to use STL statistical fallback — no credentials needed
WATSONX_GRANITE_TTM_ENABLED=false

# Granite Instruct: IBM Granite instruct model for operator brief (Feature 5)
# Set to true to use ibm/granite-3-3-8b-instruct via watsonx.ai text generation API
# Set to false (default) to use Jinja2 template brief — no credentials needed
WATSONX_BRIEF_ENABLED=false

# ── Backend ───────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# ── Data ──────────────────────────────────────────────────────────────────────
# Path to the grid dataset CSV, relative to src/
# Run python data/generate_dataset.py to create this file
GRID_DATA_PATH=data/grid_data.csv
